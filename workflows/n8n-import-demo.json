    {
      "id": "1185bb7bbcf3d5b63f0a4ddd421066dc",
      "name": "02 | Validate Source Dates + Metric Contracts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$input.first().json;function check(x,msg){if(!x)throw new Error('QA blocked: '+msg)}\ncheck(d.dataset_kind==='synthetic','production data cannot be used in public demo');\nconst g=d.gsc.daily,a=d.ga4.daily;\ncheck(d.gsc.truncated===false&&d.ga4.truncated===false,'API row limit reached');\ncheck(g.length>=14&&a.length>=14,'too few days');\nconst days=[...new Set(g.map(x=>x.date))].sort();\ncheck(days.length===14,'GSC dates missing or duplicated');\ncheck(g.every(x=>x.status==='final'&&Number.isInteger(x.clicks)&&x.clicks>=0&&x.clicks<=x.impressions),'GSC must be finalized');\ncheck(a.every(x=>x.status==='matured'&&x.event_name==='prospectus_form_submit'&&Number.isInteger(x.event_count)),'GA4 event not confirmed/matured');\ncheck(new Set(a.map(x=>x.date)).size===14,'GA4 date coverage missing');\ncheck(d.clarity_snapshots.length<1000,'Clarity has hit API row cap');\ncheck(d.crm_fixture.mode==='synthetic_fixture','CRM integration requires a connected account');\nreturn [{json:{...d,qa:{coverage:'PASS',leadEvent:'prospectus_form_submit',sourceRows:g.length+a.length}}}];"
      }
    },
    {
      "id": "e2e9cc0b216d76e3435e842d8726e290",
      "name": "03 | Normalize + Deduplicate Upserts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$input.first().json;\nconst dedupe=(rows,fields)=>{const by=new Map();for(const r of rows){const k=fields.map(f=>r[f]).join('|');if(by.has(k)&&JSON.stringify(by.get(k))!==JSON.stringify(r))throw new Error('Conflicting duplicate: '+k);by.set(k,r)}return [...by.values()]};\nconst g=dedupe(d.gsc.daily,['date']);const a=dedupe(d.ga4.daily,['date','event_name']);\nconst c=dedupe(d.crm_fixture.contacts,['contact_id']);\nreturn [{json:{...d,gsc:{...d.gsc,daily:g},ga4:{...d.ga4,daily:a},crm_fixture:{...d.crm_fixture,contacts:c},qa:{...d.qa,deduped:true}}}];"
      }
    },
    {
      "id": "41b0ec59bbbb419ed9f989719afe372d",
      "name": "04 | Calculate Search + Prospectus Trends",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$input.first().json;const start=d.reporting_window.current_start;const sum=(rows,field,latest)=>rows.filter(x=>latest?x.date>=start:x.date<start).reduce((n,x)=>n+Number(x[field]||0),0);\nconst kpi=(rows,field)=>{const p=sum(rows,field,false),c=sum(rows,field,true);return {previous:p,current:c,change_pct:p?Math.round((c-p)*1000/p)/10:null}};\nconst stats={gsc_organic_clicks:kpi(d.gsc.daily,'clicks'),gsc_impressions:kpi(d.gsc.daily,'impressions'),ga4_organic_sessions:kpi(d.ga4.daily,'organic_sessions'),ga4_prospectus_form_submit_events:kpi(d.ga4.daily,'event_count')};\nreturn [{json:{...d,stats}}];"
      }
    },
    {
      "id": "00c39f38e3d052b9b32f9377c32d5377",
      "name": "05 | CRM Adapter (Simulated) + Reconciliation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$input.first().json,contacts=d.crm_fixture.contacts;const unique=new Set(contacts.map(x=>x.contact_id));if(unique.size!==contacts.length)throw new Error('CRM duplicate contact IDs');\nconst events=d.stats.ga4_prospectus_form_submit_events.current;\nconst crm={mode:'SYNTHETIC ONLY: no live CRM connection',unique_contacts:unique.size,ga4_event_occurrences:events,difference:events-unique.size,status:'needs_follow_up',note:'Event occurrences and unique CRM contacts have different measurement units.'};\nreturn [{json:{...d,crm}}];"
      }
    },
    {
      "id": "976bda7e5fe371ee2aacccc542e30b5d",
      "name": "06 | Clarity Organic / Paid Mobile Friction",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const d=$input.first().json,rows=d.clarity_snapshots;const dates=[...new Set(rows.map(x=>x.captured_on))].sort();if(dates.length<2)throw new Error('Need two Clarity captures');const latest=dates.at(-1),before=dates.at(-2);const index=new Map(rows.filter(x=>x.captured_on===before).map(x=>[x.channel+'|'+x.device,x]));let issues=[];\nfor(const curr of rows.filter(x=>x.captured_on===latest)){\n if(!curr.verified||curr.dead_click_session_pct<0||curr.dead_click_session_pct>100)throw new Error('Invalid Clarity percentage');\n const key=curr.channel+'|'+curr.device,prev=index.get(key);if(!prev||Math.min(curr.sessions,prev.sessions)<100)continue;\n const diff=Math.round((curr.dead_click_session_pct-prev.dead_click_session_pct)*10)/10;\n if(curr.dead_click_session_pct>=15&&diff>=5)issues.push({segment:key,metric:'dead_click_session_pct',current_pct:curr.dead_click_session_pct,change_pp:diff,sessions:curr.sessions,action:'Inspect recordings and heatmaps, test CTA and forms'});\n if(curr.script_error_count>=10)issues.push({segment:key,metric:'script_error_count',events:curr.script_error_count,action:'Check JavaScript and form submission logs'});\n}\nreturn [{json:{...d,clarity_summary:{latest_capture:latest,scope:'sitewide channel x device',issues}}}];"
      }
    },
    {
      "id": "448437426887b7f317db433fb6dcbe67",
      "name": "07 | Track Blog 7 / 14 / 28-Day Cohorts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
